{
  "name": "expert4visas-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "node test/api.test.js",
    "check": "wrangler deploy --dry-run --outdir .build",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "configure": "node scripts/configure.mjs",
    "connect:frontend": "node scripts/connect-frontend.mjs",
    "secrets:generate": "node scripts/generate-secrets.mjs"
  },
  "devDependencies": {
    "wrangler": "4.139.0"
  }
}
