# Documentation only: load through a protected service environment, never commit real values.
APP_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
ALLOWED_ORIGINS=https://example.com
TRUSTED_HOSTS=example.com
DATABASE_PATH=/var/lib/theworldmigration/leads.db
# Redis must be private, authenticated, and shared by all workers. Use rediss for remote TLS.
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
# serve.py already validates proxy headers through Waitress.
PROXY_HOPS=0

# Generate with python hash_editor_password.py; empty disables editor login.
EDITOR_PASSWORD_HASH=
